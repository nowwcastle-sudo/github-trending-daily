{
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test && python -m unittest discover -s tests -p \"test_*.py\"",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:all": "npm test && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.17.1",
    "firebase-tools": "15.28.1"
  }
}
